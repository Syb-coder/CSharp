<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Windows 认证连接字符串，指向本地 SQL Server 的 HotelDB 数据库 -->
		<!-- 程序启动时 DBInitializer 会自动探测 localhost / localhost\SQLEXPRESS 等候选实例 -->
		<add name="HotelDB"
			 connectionString="Server=localhost;Database=HotelDB;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
