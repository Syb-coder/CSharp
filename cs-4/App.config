<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Windows 认证连接字符串，指向本地 SQL Server 的 CampusStore 数据库 -->
		<!-- 连接字符串集中配置在此处，禁止在 UI/BLL 层硬编码，符合 PRD 安全性要求 -->
		<add name="CampusStore"
			 connectionString="Server=localhost;Database=CampusStore;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
