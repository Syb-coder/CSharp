<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Windows 认证连接字符串，指向本地 SQL Server 2025 的 LibraryDB 数据库 -->
		<add name="LibraryDB"
			 connectionString="Server=localhost;Database=LibraryDB;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
