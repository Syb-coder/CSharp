<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Windows 认证连接字符串，指向本地 SQL Server 的 LibraryDB 数据库 -->
		<!-- cs-5 与 cs-1 共用 LibraryDB 实例，通过 T_ 表前缀区分（cs-1 使用 tbl_ 前缀） -->
		<add name="LibraryDB"
			 connectionString="Server=localhost;Database=LibraryDB;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
